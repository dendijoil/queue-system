# Salin ke apps/api/.env lalu sesuaikan
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Role aplikasi: bukan superuser, tanpa BYPASSRLS, jadi RLS berlaku (ADR-002)
DATABASE_URL=postgres://app_rw:app_rw@localhost:5432/antrian
# Role pemilik tabel, hanya untuk pnpm db:migrate / db:generate
MIGRATION_DATABASE_URL=postgres://antrian:antrian@localhost:5432/antrian
REDIS_URL=redis://localhost:6379
