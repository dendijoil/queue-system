{
  "name": "@antrian/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "SDK JavaScript untuk REST API v1 dan verifikasi webhook queue engine.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./webhook": {
      "types": "./dist/webhook.d.ts",
      "default": "./dist/webhook.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@antrian/shared": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^5.1.1"
  }
}
